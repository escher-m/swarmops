# Copy to .env and fill in. .env is gitignored.

# --- LLM credentials for HolmesGPT -------------------------------------------
# HolmesGPT reasons with an LLM; without one it cannot investigate.
# Set exactly one provider.
ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Model HolmesGPT should use. Anthropic's current models are the Claude 5
# family; claude-sonnet-5 is the sensible default for this workload.
HOLMES_MODEL=anthropic/claude-sonnet-5

# --- Local infrastructure (defaults match scripts/pg.sh) ----------------------
SWARMOPS_LEDGER_DSN=
SEEDAPP_DSN=
SEEDAPP_PORT=8081

# --- Dashboard authentication -------------------------------------------------
# The dashboard can approve and execute changes, so it refuses to start without
# one of these set. An unauthenticated approve record is a lie told in a
# tamper-evident way.

# Real deployment: any OpenID Connect provider.
# SWARMOPS_AUTH_MODE=oidc
# SWARMOPS_OIDC_DISCOVERY_URL=https://your-org.okta.com/.well-known/openid-configuration
# SWARMOPS_OIDC_CLIENT_ID=
# SWARMOPS_OIDC_CLIENT_SECRET=
# SWARMOPS_OIDC_REDIRECT_URL=https://ledger.your-org.internal/auth/callback
# SWARMOPS_OIDC_PROVIDER_NAME=okta        # prefixes approver_id, e.g. okta|00u4k2
# SWARMOPS_OIDC_ROLES_CLAIM=groups        # claim carrying the user's roles
# SWARMOPS_APPROVER_ROLES=sre-oncall      # roles permitted to approve
# SWARMOPS_SECRET_KEY=                    # required in production; openssl rand -base64 48
# SWARMOPS_ENV=production

# Laptop demo: identities from dev_users.json. Refused when SWARMOPS_ENV=production.
SWARMOPS_AUTH_MODE=dev

# Session lifetime in seconds (default 8 hours).
# SWARMOPS_SESSION_MAX_AGE=28800
