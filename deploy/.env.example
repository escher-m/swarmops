# Copy to deploy/.env and fill in. deploy/.env is gitignored.
#
#   docker compose --env-file deploy/.env -f deploy/docker-compose.yml up -d

# --- database -----------------------------------------------------------------
# The superuser credential is used only by the entrypoint, to run migrations and
# set the application role's password. The application never sees it.
SWARMOPS_DB_SUPERUSER_PASSWORD=          # openssl rand -base64 32
SWARMOPS_APP_PASSWORD=                   # openssl rand -base64 32
SWARMOPS_DB_NAME=swarmops_ledger

# --- sessions -----------------------------------------------------------------
SWARMOPS_SECRET_KEY=                     # openssl rand -base64 48

# --- authentication -----------------------------------------------------------
# SWARMOPS_ENV=production is set in the compose file, which makes the dashboard
# refuse to start with dev identities or no authentication at all.
SWARMOPS_AUTH_MODE=oidc
SWARMOPS_OIDC_DISCOVERY_URL=https://your-org.okta.com/.well-known/openid-configuration
SWARMOPS_OIDC_CLIENT_ID=
SWARMOPS_OIDC_CLIENT_SECRET=
SWARMOPS_OIDC_REDIRECT_URL=https://ledger.your-org.internal/auth/callback
SWARMOPS_OIDC_PROVIDER_NAME=okta         # prefixes approver_id, e.g. okta|00u4k2
SWARMOPS_OIDC_ROLES_CLAIM=groups
SWARMOPS_APPROVER_ROLES=sre-oncall

# --- networking ---------------------------------------------------------------
# Loopback by default. Only widen this once a TLS-terminating proxy is in front:
# session cookies are marked Secure only when the request arrived over HTTPS.
SWARMOPS_BIND=127.0.0.1
